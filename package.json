{
  "name": "@fluritheme/spider",
  "version": "0.1.1",
  "description": "A tiny, expressive spider for your website. Delicate webs that follow DOM layers, blinking eyes, and playful pointer reactions.",
  "type": "module",
  "license": "MIT",
  "author": "Frantisek Gejdos <fluritheme@gmail.com>",
  "homepage": "https://spider.fluri.xyz/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluritheme/spider.git"
  },
  "bugs": {
    "url": "https://github.com/fluritheme/spider/issues"
  },
  "keywords": [
    "spider",
    "spiderweb",
    "cobweb",
    "web-animation",
    "halloween",
    "canvas",
    "dom",
    "interactive",
    "typescript",
    "react",
    "vue",
    "fluri"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:site": "vite build",
    "dev": "vite --host 127.0.0.1 --port 5198",
    "preview": "vite preview --host 127.0.0.1 --port 4198",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm build:site && pnpm test:browser",
    "release:check": "node scripts/release-check.mjs",
    "deploy": "pnpm build:site && wrangler deploy",
    "prepublishOnly": "pnpm build && pnpm release:check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
